<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Prism AAC</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>de</string>
		<string>en</string>
		<string>es</string>
		<string>fr</string>
		<string>he</string>
		<string>hi</string>
		<string>id</string>
		<string>it</string>
		<string>ja</string>
		<string>ko</string>
		<string>nl</string>
		<string>pl</string>
		<string>pt</string>
		<string>ro</string>
		<string>ru</string>
		<string>fil</string>
		<string>tr</string>
		<string>uk</string>
		<string>vi</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>zh-HK</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.8.6</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>prism-aac</string>
				<string>ai.synalux.prism-aac</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>47</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Prism AAC uses the camera for hands-free head tracking and to create custom picture symbols.</string>
	<key>NSContactsUsageDescription</key>
	<string>Prism AAC reads your contacts to find caregivers and emergency contacts for alerts.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Prism AAC can share your location with emergency contacts when you trigger an SOS alert.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Prism AAC uses the microphone for voice input so you can speak phrases hands-free.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Prism AAC can import photos from your library to create custom communication pictures.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Prism AAC converts your voice to text so you can compose messages by speaking.</string>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prismaac.help</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Help</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>exclamationmark.triangle</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prismaac.yes</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Yes</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>checkmark.circle</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prismaac.no</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>No</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>xmark.circle</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.prismaac.water</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Water please</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>drop</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>systemBackground</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
