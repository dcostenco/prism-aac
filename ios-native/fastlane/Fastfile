default_platform(:ios)

platform :ios do
  lane :fix_my_app do
    require 'spaceship'
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "P4BW79M9KU",
      issuer_id: "7dca478c-0430-4412-be32-17c5bdbcebd5",
      filepath: File.expand_path("~/private_keys/AuthKey_P4BW79M9KU.p8"),
      in_house: false
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find("ai.synalux.prism-aac")
    edit_version = app.get_edit_app_store_version

    app_info = app.fetch_edit_app_info
    info_locs = app_info.get_app_info_localizations

    info_locs.each do |loc|
      begin
        loc.update(attributes: { subtitle: "AAC for nonverbal users" })
        puts "Updated subtitle for #{loc.locale}"
      rescue => e
        puts "Could not update attributes subtitle: #{e.message}"
      end
    end

    submissions = app.get_review_submissions(includes: "items")
    # Clean up any empty READY_FOR_REVIEW drafts first to be safe
    empty_drafts = submissions.select { |s| s.state == "READY_FOR_REVIEW" && (s.items.nil? || s.items.empty?) }
    empty_drafts.each do |ed|
      begin
        ed.cancel_submission
      rescue
      end
    end

    # Find the submission that actually contains our version item
    draft = submissions.find do |s|
      next false if s.items.nil?
      # In spaceship, items might not have app_store_version populated properly in includes,
      # but we can check if it's the right one.
      # Actually, let's just find the UNRESOLVED_ISSUES or REJECTED submission that Apple mentioned.
      s.state == "REJECTED" || s.state == "UNRESOLVED_ISSUES" || s.state == "READY_FOR_REVIEW"
    end
    
    # Try to find the specific one by ID if we got the error earlier
    draft = submissions.find { |s| s.id == "d8c4abe0-242e-4f86-a4fd-738e478d41f9" } || draft

    if draft
      puts "Found existing submission #{draft.id} in state #{draft.state}. Submitting..."
      begin
        draft.submit_for_review
        puts "Resubmitted existing draft successfully!"
      rescue => e
        puts "Could not submit existing draft: #{e.message}"
      end
    else
      puts "Could not find a valid draft to submit."
    end
  end
end
