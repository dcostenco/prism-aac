default_platform(:ios)

platform :ios do
  desc "Build and upload to App Store Connect"
  lane :release do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: "P4BW79M9KU",
      issuer_id: "7dca478c-0430-4412-be32-17c5bdbcebd5",
      key_filepath: File.expand_path("~/private_keys/AuthKey_P4BW79M9KU.p8"),
      in_house: false
    )

    cert(api_key: api_key)
    sigh(api_key: api_key, app_identifier: "ai.synalux.prism-aac")
    sigh(api_key: api_key, app_identifier: "ai.synalux.prism-aac.watchkitapp")

    build_app(
      project: "PrismAAC.xcodeproj",
      scheme: "PrismAAC",
      export_method: "app-store",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=Z4UYN9388M"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Submit to App Store Review"
  lane :submit_for_review do
    setup_ci
    api_key = app_store_connect_api_key(
      key_id: "P4BW79M9KU",
      issuer_id: "7dca478c-0430-4412-be32-17c5bdbcebd5",
      key_filepath: File.expand_path("~/private_keys/AuthKey_P4BW79M9KU.p8"),
      in_house: false
    )
    deliver(
      api_key: api_key,
      submit_for_review: true,
      force: true,
      skip_screenshots: true,
      skip_binary_upload: true,
      app_version: "1.8.2",
      build_number: "34",
      phased_release: true,
      run_precheck_before_submit: false,
      release_notes: {
        "en-US" => "Bug fixes and performance improvements."
      }
    )
  end

  desc "Submit using raw spaceship"
  lane :submit_spaceship do
    require 'spaceship'
    token = Spaceship::ConnectAPI::Token.create(
      key_id: "P4BW79M9KU",
      issuer_id: "7dca478c-0430-4412-be32-17c5bdbcebd5",
      filepath: File.expand_path("~/private_keys/AuthKey_P4BW79M9KU.p8"),
      in_house: false
    )
    Spaceship::ConnectAPI.token = token

    app = Spaceship::ConnectAPI::App.find("ai.synalux.prism-aac")
    edit_version = app.get_edit_app_store_version
    
    locs = edit_version.get_app_store_version_localizations
    locs.each do |loc|
      begin
        loc.update(whats_new: "Bug fixes and performance improvements.")
        puts "Updated whats_new for #{loc.locale}"
      rescue => e
        # Old version of spaceship uses a different argument or property?
        # AppStoreVersionLocalization update method in spaceship 2.234.0:
        # update(attributes: { whatsNew: "..." })
        begin
          loc.update(attributes: { whatsNew: "Bug fixes and performance improvements." })
        rescue => e2
          puts "Failed to update whatsNew: #{e2.message}"
        end
      end
    end

    submissions = app.get_review_submissions(includes: "items")
    draft = submissions.find { |s| s.state == "READY_FOR_REVIEW" }
    
    if draft
      puts "Draft found! Adding items to draft..."
      begin
        draft.add_app_store_version_to_review_items(app_store_version_id: edit_version.id)
      rescue => e
        puts "Warning adding item: #{e.message}"
      end
      puts "Submitting draft submission..."
      draft.submit_for_review
      puts "Draft submitted successfully!"
    else
      puts "No draft submission found!"
      
      puts "Creating review submission for version #{edit_version.version_string}"
      begin
        submission = app.create_review_submission
        submission.add_app_store_version_to_review_items(app_store_version_id: edit_version.id)
        submission.submit_for_review
        puts "Submitted successfully!"
      rescue => e
        puts "Error submitting: #{e.message}"
      end
    end
  end
end
