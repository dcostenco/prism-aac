{
  "name": "prism-aac-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "description": "PrismAAC Reading Assistant — Chrome extension. Speak as you type, sentence-end speak, word-by-word highlight, in any text field.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "node scripts/gen-icons.mjs && node build.mjs --package",
    "icons": "node scripts/gen-icons.mjs",
    "assets": "node scripts/gen-store-assets.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.279",
    "esbuild": "^0.28.1",
    "typescript": "^5",
    "vitest": "^4"
  }
}
