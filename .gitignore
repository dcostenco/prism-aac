# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.expo/
ios/
dist/
test-results/
prism-deep-review.txt
*.txt
!LICENSE.txt
.venv-tools/

# Local scratch files — debugging snippets that don't belong in source.
# Pattern matches root-level test-correct-* drafts left over from
# autocorrect / TTS investigation sessions.
/test-correct*.js
/test-correct*.ts
ios-native/PrismAAC/Resources/*.gguf
.env*.local

# iOS build artifacts & signing (NEVER commit to public repo)
*.ipa
*.app.dSYM.zip
*.mobileprovision
*.cer
*.p12
*.certSigningRequest
# App Store Connect API keys. The .p8 is the only half of the credential that
# is actually secret — the key_id and issuer_id in fastlane/ are identifiers
# that cannot authenticate without it. Keys live in ~/private_keys, outside
# any repo; these patterns exist so a stray copy can never be staged.
*.p8
AuthKey_*
private_keys/
ios-native/_llama_cpp_local

# Ad-hoc device-layout audit captures. Regenerated on demand by the layout
# scripts; 6.9MB of them accumulated untracked from a July board fix.
screenshots/audit/
