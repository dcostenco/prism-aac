{
  "_meta": {
    "purpose": "Override known-bad entries in Cboard's translations.",
    "rationale": "Cboard is community-translated and certain Universal Core 36 keys (notably symbol.pronouns.I) are left untranslated, off-by-one (single Cyrillic letter В instead of Я), or mistranslated (Chinese 一 'one' instead of 我 'I') in many locales. These overrides apply ONLY to entries where the Cboard value is empirically wrong; everything else passes through Cboard untouched.",
    "format": "Each entry: { '<lang>': { '<symbol_key>': { value: '<correct>', source: '<citation>' } } }"
  },
