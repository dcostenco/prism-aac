{
  "name": "prism-aac-web",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:mobile": "playwright test --project=iphone-6.1 --project=iphone-6.5 --project=iphone-6.9",
    "e2e:tablet": "playwright test --project=ipad-7 --project=ipad-13",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:verify": "node scripts/verify-state-coverage.mjs",
    "visual": "npm run visual:check && PANEL_HEIGHT_CAP=200 ALLOW_BRANCH_UNKNOWN=1 NO_CAP_PASSES=math-grid-empty,math-grid-typed,math-panel-integrated REQUIRED_PASSES=ai-unconfigured,ai-configured-empty,aac-empty,math-grid-empty,math-grid-typed,math-panel-integrated npm run visual:verify",
    "e2e:watchdog": "MIN_FREE_GB=2 ./scripts/playwright-watchdog.sh e2e/panel-compact-when-empty.spec.ts --project=desktop --workers=1"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.1.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@serwist/next": "^9.5.8",
    "@supabase/supabase-js": "^2.105.1",
    "es-hangul": "^2.3.8",
    "katex": "^0.16.45",
    "mathjs": "^15.2.0",
    "next": "16.2.4",
    "pdfjs-dist": "^5.7.284",
    "pyodide": "^0.29.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.8",
    "shiki": "^4.0.2",
    "snowball-stemmers": "^0.6.0",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.1.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
